# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API (web app, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Where the web app is served (used in links, e.g. PayPal return URLs)
PUBLIC_WEB_URL=http://localhost:5173
# Run database migrations automatically when the server starts (handy in Docker)
MIGRATE_ON_START=false
# Background housekeeping (expire idle carts, release unpaid orders, auto clock-out)
ENABLE_JOBS=true

# --- Database / cache -----------------------------------------------------------
DATABASE_URL=postgres://smartcart:smartcart@localhost:5432/smartcart
# Optional: enables the Socket.IO Redis adapter for running several API instances
REDIS_URL=

# --- Auth -----------------------------------------------------------------------
# REQUIRED in production: a long random string (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set to true when the API is served over HTTPS
COOKIE_SECURE=false

# Google Sign-In (OAuth client IDs from Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Sign in with Apple: comma-separated audiences (iOS bundle id, web service id)
APPLE_CLIENT_IDS=
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=
# Development helpers: simulated Google/Apple buttons and OTP codes echoed in responses
AUTH_DEMO_SOCIAL=true
OTP_DEV_ECHO=true
# SMS for phone OTP (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Payments -------------------------------------------------------------------
CURRENCY=INR
MERCHANT_NAME=SmartCart
MERCHANT_COUNTRY=IN
# When a provider below has no keys, its methods are simulated (turn off in production)
PAYMENTS_DEMO_MODE=true
# Stripe: cards, Apple Pay, Google Pay
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal (sandbox or live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Razorpay: UPI (intent, collect and QR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Push notifications ------------------------------------------------------------
PUSH_ENABLED=true
# Optional Expo access token (required if push security is enabled on your Expo project)
EXPO_ACCESS_TOKEN=
